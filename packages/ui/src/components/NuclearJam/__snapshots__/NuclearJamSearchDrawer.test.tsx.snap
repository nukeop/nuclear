    >
      <div
        class="flex flex-col items-center justify-center text-center gap-4 p-8 flex-1"
        data-testid="jam-search-empty"
      >
        <div
          class="text-foreground"
        >
          <svg
            aria-hidden="true"
            class="lucide lucide-search-x"
            fill="none"
            height="48"

              d="m21 21-4.3-4.3"
            />
          </svg>
        </div>
        <div
          class="flex flex-col gap-1"
        >
          <h3
            class="text-foreground text-lg font-bold"
          >
            No results
          </h3>
          <p
            class="text-foreground text-sm opacity-60"
          >
            Try a different search
          </p>
        </div>
      </div>
    </div>

---
import CommandLine from '../components/CommandLine.astro';
import DownloadNote from '../components/download/DownloadNote.astro';
import DownloadSection from '../components/download/DownloadSection.astro';
import FeaturedPlatform from '../components/download/FeaturedPlatform.astro';
import PlatformCard from '../components/download/PlatformCard.astro';
import ReleaseInfo from '../components/download/ReleaseInfo.astro';
import { macQuarantineCommand, platforms } from '../data/platforms';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Download Nuclear for Windows, macOS, and Linux';
const description =
  'Download Nuclear, the free and open-source music player without ads or tracking. Installers for Windows, macOS (Apple Silicon and Intel), and Linux, plus Flathub, Snap, AUR, winget, and Homebrew.';

const DOCS_URL = 'https://docs.nuclearplayer.com/nuclear';
---

<BaseLayout title={title} description={description}>
  <main
    class="bg-muted w-full bg-[radial-gradient(var(--background)_1px,transparent_1px)] bg-size-[20px_20px]"
  >
    <div class="mx-auto w-full max-w-5xl px-4 py-16 md:px-8">
      <header class="mb-12 text-center">
        <h1
          class="font-heading text-4xl font-black tracking-widest uppercase md:text-5xl"
        >
          Download Nuclear
        </h1>
        <p class="text-foreground/60 mt-3 mb-4 font-bold">
          Nuclear is free and open source, and runs on Windows, macOS, and Linux.
        </p>
        <ReleaseInfo />
      </header>

      <div class="relative">
        <img
          src="/images/nuki-box.png"
          alt=""
          class="pointer-events-none absolute left-4 bottom-full -mb-0.5 hidden w-36 select-none md:block"
        />
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
          {platforms.map((platform) => <FeaturedPlatform platform={platform} />)}
        </div>
      </div>
      <p class="text-foreground/60 mt-8 text-center text-sm font-bold">
        Looking for a .deb, an .rpm, an MSI, or a package manager? <a
          href="#all-downloads"
          class="text-foreground underline underline-offset-2 hover:no-underline"
          >See all downloads</a
        >.
      </p>

      <DownloadSection id="all-downloads" title="All downloads">
        <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-3">
          {platforms.map((platform) => <PlatformCard platform={platform} />)}
        </div>
      </DownloadSection>

      <DownloadSection id="troubleshooting" title="If it won't open">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <DownloadNote title="macOS blocks Nuclear">
            <p>
              Nuclear isn't signed with an Apple developer certificate, so macOS
              may say the app is damaged or can't be opened. Right-click the app
              and select Open. If that doesn't work, run this in Terminal:
            </p>
            <CommandLine command={macQuarantineCommand} class="text-left" />
          </DownloadNote>
          <DownloadNote title="Windows shows a SmartScreen warning">
            <p>
              The installer isn't code-signed, so Windows may warn you before it
              runs. Click More info, then Run anyway.
            </p>
          </DownloadNote>
        </div>
      </DownloadSection>

      <DownloadSection id="more" title="More ways to get Nuclear">
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
          <DownloadNote title="On your phone?">
            <p>
              Nuclear is a desktop app, so there's no Android or iOS version.
              You can still control Nuclear from your phone with the <a
                href={`${DOCS_URL}/user-manual/remote-control`}
                class="underline underline-offset-2 hover:no-underline"
                >remote control</a
              >.
            </p>
          </DownloadNote>
          <DownloadNote title="Older versions">
            <p>
              Every release, including older versions, is on the <a
                href="https://github.com/nukeop/nuclear/releases"
                class="underline underline-offset-2 hover:no-underline"
                >GitHub releases page</a
              >. The <a
                href={`${DOCS_URL}/user-manual/installation`}
                class="underline underline-offset-2 hover:no-underline"
                >installation guide</a
              > has more detail for each platform.
            </p>
          </DownloadNote>
        </div>
      </DownloadSection>
    </div>
  </main>
</BaseLayout>

<script>
  import { detectOperatingSystem } from '../lib/download/detectOperatingSystem';

  const operatingSystem = detectOperatingSystem(
    navigator.userAgent,
    navigator.maxTouchPoints,
  );

  if (operatingSystem) {
    document
      .querySelectorAll<HTMLElement>(`[data-platform="${operatingSystem}"]`)
      .forEach((element) => {
        element.dataset.detected = '';
      });
  }
</script>

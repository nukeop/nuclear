---
import { Image } from 'astro:assets';

import album from '../../../docs/.gitbook/assets/album.png';
import artist from '../../../docs/.gitbook/assets/artist.png';
import favoriteArtists from '../../../docs/.gitbook/assets/favorite-artists.png';
import installedPlugins from '../../../docs/.gitbook/assets/installed-plugins.png';
import playlistDetailView from '../../../docs/.gitbook/assets/playlist-detail-view.png';
import playlists from '../../../docs/.gitbook/assets/playlists.png';
import pluginStore from '../../../docs/.gitbook/assets/plugin-store.png';
import searchArtists from '../../../docs/.gitbook/assets/search-artists.png';
import Box from './Box.astro';
import ThemeShowcase from './ThemeShowcase.astro';

type ScreenshotEntry = {
  src: typeof searchArtists;
  alt: string;
};

type Nuki = {
  src: string;
  alt: string;
  placement: string;
};

type FeatureBlock = {
  heading: string;
  description: string;
  images: ScreenshotEntry[];
  layout: 'text-left' | 'text-right';
  nuki?: Nuki;
};

const featureBlocks: FeatureBlock[] = [
  {
    heading: 'Discovery',
    description:
      'Search for and browse artists, albums, and tracks across multiple sources. Plugins can add more sources.',
    images: [
      { src: searchArtists, alt: 'Search artists in Nuclear' },
      { src: artist, alt: 'Artist page in Nuclear' },
      { src: album, alt: 'Album page in Nuclear' },
    ],
    layout: 'text-left',
  },
  {
    heading: 'Your library',
    description:
      'Put together playlists from any source, or import them from other services and JSON files. Keep your favorite artists, albums, and tracks in one place.',
    images: [
      { src: playlists, alt: 'Playlists view in Nuclear' },
      { src: playlistDetailView, alt: 'Playlist detail view in Nuclear' },
      { src: favoriteArtists, alt: 'Favorite artists in Nuclear' },
    ],
    layout: 'text-right',
    nuki: {
      src: '/images/nuki-studying.png',
      alt: 'Nuki studying at a desk',
      placement: 'right-0 bottom-0',
    },
  },
  {
    heading: 'Plugins',
    description:
      'Nuclear can be extended with a powerful plugin API, and has a plugin store. Auto-update is built in.',
    images: [
      { src: pluginStore, alt: 'Plugin store in Nuclear' },
      { src: installedPlugins, alt: 'Installed plugins in Nuclear' },
    ],
    layout: 'text-left',
    nuki: {
      src: '/images/nuki-ready-to-work.png',
      alt: 'Nuki holding a wrench and toolbox',
      placement: 'left-[8%] bottom-0',
    },
  },
];
---

<div class="flex w-full flex-col gap-16 md:gap-24">
  {featureBlocks.map((block, blockIndex) => {
    const isReversed = block.layout === 'text-right';

    return (
      <>
        <div
          class:list={[
            'grid items-center gap-8 md:gap-12',
            isReversed
              ? 'md:grid-cols-[3fr_2fr] md:*:first:order-2'
              : 'md:grid-cols-[2fr_3fr]',
          ]}
        >
          <div class="flex flex-col gap-4">
            <h3 class="font-heading text-[clamp(1.75rem,3vw,2.5rem)] leading-tight font-black tracking-wider uppercase">
              {block.heading}
            </h3>
            <p class="max-w-[38ch] text-base leading-relaxed opacity-75">
              {block.description}
            </p>
          </div>

          <div class="relative">
            {block.nuki && (
              <img
                src={block.nuki.src}
                alt={block.nuki.alt}
                class:list={[
                  'pointer-events-none absolute z-10 w-24 select-none md:w-36 xl:w-44',
                  block.nuki.placement,
                ]}
              />
            )}
            <div class="flex flex-col perspective-distant *:w-[72%] *:odd:-rotate-1 *:odd:rotate-y-12 *:not-first:-mt-10 *:even:rotate-1 *:even:-rotate-y-12 *:even:self-end md:*:w-[55%] md:*:not-first:-mt-20">
              {block.images.map((image) => (
                <Box>
                  <div class="leading-0">
                    <Image
                      src={image.src}
                      alt={image.alt}
                      inferSize
                      widths={[720, 1080, 1440]}
                      sizes="(max-width: 768px) 90vw, 420px"
                      quality={90}
                      class="block w-full"
                    />
                  </div>
                </Box>
              ))}
            </div>
          </div>
        </div>

        {blockIndex === 1 && <ThemeShowcase />}
      </>
    );
  })}
</div>

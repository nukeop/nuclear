---
import { Image } from 'astro:assets';

import dashboardArcticMossDark from '../../../docs/.gitbook/assets/dashboard-arctic-moss-dark.png';
import dashboardAuroraLight from '../../../docs/.gitbook/assets/dashboard-aurora-light.png';
import dashboardChesterfield from '../../../docs/.gitbook/assets/dashboard-chesterfield.png';
import dashboardDefaultDark from '../../../docs/.gitbook/assets/dashboard-default-dark.png';
import dashboardEmberLight from '../../../docs/.gitbook/assets/dashboard-ember-light.png';
import dashboardLagoonDark from '../../../docs/.gitbook/assets/dashboard-lagoon-dark.png';
import dashboardLagoonLight from '../../../docs/.gitbook/assets/dashboard-lagoon-light.png';
import dashboardNebula from '../../../docs/.gitbook/assets/dashboard-nebula.png';
import dashboardRiso from '../../../docs/.gitbook/assets/dashboard-riso.png';
import dashboardSeigaiha from '../../../docs/.gitbook/assets/dashboard-seigaiha.png';
import settingsNebula from '../../../docs/.gitbook/assets/settings-nebula.png';

const topRow = [
  dashboardAuroraLight,
  dashboardEmberLight,
  dashboardLagoonLight,
];

const bottomRow = [
  dashboardDefaultDark,
  dashboardLagoonDark,
  dashboardArcticMossDark,
];

const customThemes = [
  dashboardRiso,
  dashboardNebula,
  settingsNebula,
  dashboardSeigaiha,
  dashboardChesterfield,
];

const desktopRows = [[...topRow, ...bottomRow], customThemes];

const mobileRows = [
  { themes: topRow, reverse: false },
  { themes: bottomRow, reverse: true },
  { themes: customThemes, reverse: false },
];
---

<div class="w-full">
  <h3
    class="font-heading mb-8 text-center text-2xl font-black tracking-widest uppercase md:text-3xl"
  >
    Built-in themes
  </h3>

  <div class="flex flex-col gap-12">
    {
      desktopRows.map((themes) => (
        <div class="themes-cascade desktop">
          {themes.map((screenshot) => (
            <div class="theme-card themed-border border-border shadow-shadow bg-primary overflow-hidden rounded-md">
              <Image
                src={screenshot}
                alt=""
                widths={[720, 1080, 1440]}
                sizes="(max-width: 1024px) 30vw, 320px"
                quality={90}
                class="block w-full"
              />
            </div>
          ))}
        </div>
      ))
    }
  </div>

  <div class="mobile-rows">
    {
      mobileRows.map((row) => (
        <div class:list={['themes-cascade mobile-row', row.reverse && 'reverse']}>
          {row.themes.map((screenshot) => (
            <div class="theme-card themed-border border-border shadow-shadow bg-primary overflow-hidden rounded-md">
              <Image
                src={screenshot}
                alt=""
                widths={[720, 1080, 1440]}
                sizes="45vw"
                quality={90}
                class="block w-full"
              />
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .themes-cascade {
    --card-width: 320px;
    --overlap: 200px;
    --rotate-y: 25deg;

    display: flex;
    align-items: center;
    justify-content: center;
    perspective: 1400px;
  }

  .theme-card {
    flex-shrink: 0;
    width: var(--card-width);
    margin-right: calc(-1 * var(--overlap));
    transform: rotateY(calc(-1 * var(--rotate-y)));
  }

  .theme-card:last-child {
    margin-right: 0;
  }

  .mobile-rows {
    display: none;
  }

  .desktop {
    display: flex;
  }

  @media (max-width: 1024px) {
    .desktop {
      display: none;
    }

    .mobile-rows {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .mobile-row {
      --card-width: 220px;
      --overlap: 140px;
      --rotate-y: 22deg;
      perspective: 1000px;
    }

    .mobile-row.reverse .theme-card {
      transform: rotateY(var(--rotate-y));
    }
  }

  @media (max-width: 640px) {
    .mobile-row {
      --card-width: 160px;
      --overlap: 100px;
      --rotate-y: 20deg;
      perspective: 800px;
    }
  }

  @media (max-width: 480px) {
    .mobile-row {
      --card-width: 140px;
      --overlap: 85px;
    }
  }
</style>

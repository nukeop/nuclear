---
import BuiltInThemeSlices from './BuiltInThemeSlices.astro';
import CustomThemeBento from './CustomThemeBento.astro';
---

<div class="flex w-full flex-col gap-16">
  <div class="flex flex-col gap-8">
    <h3
      class="font-heading text-center text-2xl font-black tracking-widest uppercase md:text-3xl"
    >
      Built-in themes
    </h3>
    <BuiltInThemeSlices />
  </div>

  <div class="flex flex-col gap-8">
    <h3
      class="font-heading text-center text-2xl font-black tracking-widest uppercase md:text-3xl"
    >
      Custom themes
    </h3>
    <CustomThemeBento />
  </div>
</div>

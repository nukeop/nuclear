---
import NavLink from './NavLink.astro';
import SocialBar from './SocialBar.astro';
import SocialButtons from './SocialButtons.astro';
---

<header class="border-border border-b">
  <div class="flex h-16 items-center justify-between gap-3 px-4 md:px-8">
    <a href="/" class="shrink-0 overflow-hidden max-[340px]:w-6">
      <img
        src="/images/logo-full-outlined.svg"
        alt="Nuclear"
        class="dark-mode-hidden h-6 max-w-none sm:h-8"
      />
      <img
        src="/images/logo-full-light-outlined.svg"
        alt="Nuclear"
        class="dark-mode-block hidden h-6 max-w-none sm:h-8"
      />
    </a>

    <nav class="flex shrink-0 items-center">
      <div class="flex items-center gap-4 sm:mr-4 md:mr-6 md:gap-6">
        <NavLink href="/download/">Download</NavLink>
        <NavLink href="/blog/">Blog</NavLink>
      </div>
      <SocialButtons class="hidden sm:flex" />
    </nav>
  </div>
  <SocialBar class="flex sm:hidden" />
</header>

---
import { releaseDate } from '../../data/github';
import { releaseNotesUrl, version } from '../../data/version';
import { formatDate } from '../../lib/blog/format';
import TextLink from '../TextLink.astro';
---

<p
  class="text-foreground/60 flex flex-wrap items-center justify-center gap-x-2 text-sm font-bold"
>
  <span>Version {version}</span>
  {
    releaseDate && (
      <>
        <span aria-hidden="true">·</span>
        <time datetime={releaseDate}>Released {formatDate(releaseDate)}</time>
      </>
    )
  }
  <span aria-hidden="true">·</span>
  <TextLink
    href={releaseNotesUrl}
  >
    Release notes
  </TextLink>
</p>

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "Group Tauri packages",
      "matchPackageNames": ["@tauri-apps/{/,}**", "tauri-build", "tauri"],
      "groupName": "tauri"
    },
    {
      "description": "Group Testing Library packages",
      "matchPackageNames": ["@testing-library/{/,}**"],
      "groupName": "testing-library"
    },
    {
      "description": "Group TanStack packages",
      "matchPackageNames": ["@tanstack/{/,}**"],
      "groupName": "tanstack"
    },
    {
      "description": "Group ESLint packages",
      "matchPackageNames": [
        "/^eslint/",
        "/^@eslint\\//",
        "/^@typescript-eslint\\//",
        "typescript-eslint"
      ],
      "groupName": "eslint"
    },
    {
      "description": "Group Tailwind CSS packages",
      "matchPackageNames": ["@tailwindcss/{/,}**", "tailwindcss"],
      "groupName": "tailwind"
    },
    {
      "description": "Group Vitest packages",
      "matchPackageNames": ["vitest", "@vitest/{/,}**"],
      "groupName": "vitest"
    },
    {
      "description": "Group Vite packages",
      "matchPackageNames": ["vite", "@vitejs/{/,}**", "/^vite-plugin-/"],
      "groupName": "vite"
    },
    {
      "description": "Group Storybook packages",
      "matchPackageNames": ["storybook", "@storybook/{/,}**"],
      "groupName": "storybook"
    },
    {
      "description": "Group Astro packages",
      "matchPackageNames": ["astro", "@astrojs/{/,}**", "/^astro-/"],
      "groupName": "astro"
    },
    {
      "description": "Group Remotion packages",
      "matchPackageNames": ["remotion", "@remotion/{/,}**"],
      "groupName": "remotion"
    },
    {
      "description": "Group dnd-kit packages",
      "matchPackageNames": ["@dnd-kit/{/,}**"],
      "groupName": "dnd-kit"
    },
    {
      "description": "Group i18next packages",
      "matchPackageNames": ["i18next", "react-i18next"],
      "groupName": "i18next"
    },
    {
      "description": "Group D3 packages",
      "matchPackageNames": ["/^d3-/"],
      "groupName": "d3"
    },
    {
      "description": "Group Fontsource packages",
      "matchPackageNames": ["@fontsource/{/,}**", "@fontsource-variable/{/,}**"],
      "groupName": "fontsource"
    },
    {
      "description": "Group Prettier packages",
      "matchPackageNames": [
        "prettier",
        "/^prettier-plugin-/",
        "@ianvs/prettier-plugin-sort-imports"
      ],
      "groupName": "prettier"
    },
    {
      "description": "Group TypeScript type definitions",
      "matchPackageNames": ["@types/{/,}**"],
      "groupName": "typescript-types"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Rust crate updates",
      "matchManagers": ["cargo"],
      "groupName": "rust-dependencies"
    },
    {
      "description": "Auto-merge patch and minor updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeStrategy": "squash",
      "platformAutomerge": true
    },
    {
      "description": "Don't auto-merge major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "pnpm after 12.0.0 doesn't link node_modules/.bin/tauri in the offline Flathub build",
      "matchPackageNames": ["pnpm"],
      "enabled": false
    }
  ]
}
